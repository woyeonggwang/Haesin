  act: "1\uB9C9"
  title: "\uC219\uBD80\uC640\uC758 \uC7AC\uD68C"
  giver: "\uC219\uBD80"
  summary: "\uD574\uC6D4\uB3C4\uC5D0\uC11C \uC219\uBD80\uB77C \uBD80\uB974\uBA70
    \uB530\uB974\uB358 \uC0AC\uB78C\uC744 \uB9CC\uB09C\uB2E4(\uC2E4\uC740 \uD604\uC655
    \u2014 \uD61C\uB294 \uBAA8\uB978\uB2E4)."
  onStart: []
  introDialogue: []
  objectives:
  - type: 2
    description: "\uD574\uC6D4\uB3C4 \uC120\uCC29\uC7A5\uC73C\uB85C \uAC00\uAE30"
    targetId: "\uD574\uC6D4\uB3C4_\uC120\uCC29\uC7A5"
    faction: 3
    count: 1
    radius: 0
