    onEnd: []
    dialogue:
    - speaker: "\uD55C\uC724\uACB8"
      text: "\uB0B4\uC77C\uC774 \uC61B \uC8FC\uAD70\uC758 \uAE30\uC77C\uC774\uC624.
        \uC81C\uC0AC\uC0C1\uC774\uB77C\uB3C4 \uCC28\uB824 \uB4DC\uB9AC\uACE0 \uC2F6\uC740\uB370,
        \uC774 \uC12C\uC5D4 \uC544\uBB34\uAC83\uB3C4 \uC5C6\uAD6C\uB824."
    - speaker: "\uD55C\uC724\uACB8"
      text: "\uC911\uC12C \uC7A5\uD130\uC5D0 \uAC00\uBA74 \uC81C\uC218\uB97C \uAD6C\uD560
        \uC218 \uC788\uC18C. \uAD00\uAD70 \uAC80\uBB38\uC774 \uC2EC\uD560 \uD14C\uB2C8
        \uC870\uC2EC\uD558\uC2DC\uC624."
