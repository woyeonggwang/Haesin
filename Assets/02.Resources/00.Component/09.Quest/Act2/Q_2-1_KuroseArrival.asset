  onStart: []
  introDialogue:
  - speaker: "\uD61C"
    text: "\uC870\uC120 \uBC30\uB77C\uB294 \uAC78 \uB108\uBB34 \uB4DC\uB7EC\uB0B4\uC9C0
      \uB9D0\uC790. \uC5EC\uAE30\uC120 \uC6B0\uB9AC\uAC00 \uC774\uBC29\uC778\uC774\uB2E4."
  objectives:
  - type: 2
    description: "\uBC30\uC5D0\uC11C \uB0B4\uB824(E 3\uCD08) \uC0C1\uC778 \uAC70\uB9AC\uB85C
      \uAC78\uC5B4\uAC00\uAE30"
