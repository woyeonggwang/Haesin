    distance: 400
    marker: 
    ignoreTerritory: 0
    factionOverride: -1
    lines: []
  - type: 0
    text: "\uD604\uAC10\uC758 \uBA85\uC744 \uAC70\uC2AC\uB800\uC2B5\uB2C8\uB2E4 \u2014
      \uAD00\uAD70\uC774 \uD61C\uB97C \uCAD3\uC2B5\uB2C8\uB2E4"
