    dialogue:
    - speaker: "\uD604\uAC10 \uC870\uBA85\uAD6C"
      text: "\uD574\uB0C8\uAD6C\uB824. \uC774\uC81C \uC77C\uBCF8 \uB188\uB4E4\uC774
