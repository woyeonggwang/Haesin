  questId: 2-8
  act: "2\uB9C9"
  title: "\uC554\uC0B4 \uBC00\uC11C"
  giver: "\uD604\uAC10 \uC870\uBA85\uAD6C(\uBC00\uC11C)"
  summary: "\uD574\uC6D4\uB3C4\uC5D0\uC11C \uC601\uC8FC \uC554\uC0B4 \uBA85\uB839\uC774
    \uC628\uB2E4. \uBD84\uAE30 \u2460 \u2014 \uC601\uC8FC\uB97C \uC8FD\uC77C \uAC83\uC778\uAC00."
  onStart:
  - type: 5
    text: jeonryeong
    faction: 1
    value: 1
    template: 
    distance: 400
    marker: 
    ignoreTerritory: 0
    factionOverride: -1
    lines: []
  introDialogue:
  - speaker: "\uC120\uC6D0"
    text: "\uC544\uC528, \uC120\uCC29\uC7A5\uC5D0 \uD574\uC6D4\uB3C4\uC5D0\uC11C
      \uC654\uB2E4\uB294 \uC0AC\uB78C\uC774 \uAE30\uB2E4\uB9BD\uB2C8\uB2E4."
  objectives:
  - type: 0
    description: "\uAD6C\uB85C\uC138 \uC120\uCC29\uC7A5\uC758 \uD574\uC6D4\uB3C4
      \uC804\uB839 \uB9CC\uB098\uAE30"
    targetId: jeonryeong
    faction: 3
    count: 1
    radius: 0
    onBegin: []
    onEnd: []
    dialogue:
    - speaker: "\uC804\uB839"
      text: "\uD604\uAC10 \uB098\uB9AC\uC758 \uC11C\uCC30\uC785\uB2C8\uB2E4. \uC544\uBB34\uB3C4
        \uBCF4\uC9C0 \uC54A\uB294 \uB370\uC11C \uC77D\uC73C\uB77C \uD558\uC168\uC2B5\uB2C8\uB2E4."
    - speaker: "\uD604\uAC10 \uC870\uBA85\uAD6C(\uC11C\uCC30)"
      text: "\uAD6C\uB85C\uC138 \uC601\uC8FC\uB97C \uC5C6\uC560\uB77C. \uADF8\uC790\uB294
        \uC870\uC120\uC744 \uD574\uCE58\uB824 \uC99D\uAC70\uB97C \uAFB8\uBBF8\uB294
        \uC790\uB2E4."
    - speaker: "\uD604\uAC10 \uC870\uBA85\uAD6C(\uC11C\uCC30)"
      text: "\uC77C\uC744 \uB9C8\uCE58\uBA74 \uAD00\uC544\uC5D0\uC11C \uADF8\uB300\uB97C
        \uD06C\uAC8C \uC4F0\uACA0\uB2E4. \uC219\uBD80 \uB418\uC2DC\uB294 \uBD84\uAED8\uB3C4
        \uC88B\uC740 \uC18C\uC2DD\uC774 \uB420 \uAC83\uC774\uB2E4."
    - speaker: "\uD61C"
      text: "(\uC601\uC8FC\uB294 \uC65C\uAD6C\uB97C \uCAD3\uB358 \uC0AC\uB78C\uC774\uB2E4.
        \uC99D\uAC70\uB97C \uC954 \uC0AC\uB78C\uC744 \uC5C6\uC560\uB77C\uB2C8\u2026
        \uADF8\uB7F0\uB370 \uC219\uBD80\uB2D8\uC744 \uB4E4\uBA39\uC774\uB2E4\uB2C8.)"
    choices:
    - "\uC601\uC8FC\uB97C \uC8FD\uC778\uB2E4 (\uD604\uAC10\uC758 \uBA85\uC744 \uB530\uB978\uB2E4)"
    - "\uC601\uC8FC\uB97C \uC8FD\uC774\uC9C0 \uC54A\uB294\uB2E4 (\uBA85\uC744 \uAC70\uC2A4\uB978\uB2E4)"
    choiceFlags:
    - kill_lord
    - spare_lord
