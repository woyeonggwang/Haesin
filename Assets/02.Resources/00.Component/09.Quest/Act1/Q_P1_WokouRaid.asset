  act: "\uD504\uB864\uB85C\uADF8"
  title: "\uC65C\uAD6C \uC2B5\uACA9"
  giver: 
  summary: "\uBC14\uB2E4\uC5D0\uC11C \uC65C\uAD6C \uBC30\uC758 \uC2B5\uACA9\uC744
    \uBC1B\uB294\uB2E4. \uD574\uC0C1 \uC804\uD22C \uD29C\uD1A0\uB9AC\uC5BC."
  onStart: []
  introDialogue:
  - speaker: "\uC120\uC6D0"
    text: "\uC544\uC528, \uC65C\uAD6C \uBC30\uC785\uB2C8\uB2E4! \uC774\uCABD\uC73C\uB85C
      \uACE7\uC7A5 \uC635\uB2C8\uB2E4!"
  - speaker: "\uD61C"
    text: "\uD53C\uD560 \uC218 \uC5C6\uB2E4\uBA74 \uB9DE\uC120\uB2E4. \uD3EC\uB97C
      \uC900\uBE44\uD558\uB77C."
  - speaker: "\uC548\uB0B4"
    text: "\uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD \uBC84\uD2BC\uC73C\uB85C \uACA8\uB204\uACE0
      \uC67C\uCABD \uBC84\uD2BC\uC73C\uB85C \uC3E9\uB2C8\uB2E4. \uBC30 \uC606\uAD6C\uB9AC(\uD604\uCE21)\uAC00
      \uC801\uC744 \uD5A5\uD574\uC57C \uD3EC\uAC00 \uB098\uAC11\uB2C8\uB2E4."
  objectives:
  - type: 1
    description: "\uC2B5\uACA9\uD574 \uC628 \uC65C\uAD6C \uBC30 \uACA9\uCE68"
    targetId: 
    faction: 3
    count: 2
    radius: 0
