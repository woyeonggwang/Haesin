  outroDialogue:
  - speaker: "\uC120\uC6D0"
    text: "\uC65C\uAD6C\uB97C \uBB3C\uB9AC\uCCE4\uC2B5\uB2C8\uB2E4! \u2026\uC544\uC528,
      \uC800\uAE30 \uD310\uC625\uC120\uC774 \uB2E4\uAC00\uC635\uB2C8\uB2E4. \uAD00\uAD70\uC785\uB2C8\uB2E4!"
