  introDialogue:
  - speaker: "\uD61C"
    text: "\uC99D\uAC70\uB97C \uC954 \uC0AC\uB78C\uC744 \uC8FD\uC77C \uC218\uB294
      \uC5C6\uB2E4. \uD604\uAC10\uC774 \uBB34\uC5C7\uC744 \uC228\uAE30\uB294\uC9C0
      \uC54C\uC544\uB0B4\uC57C \uD574."
  objectives:
  - type: 0
    description: "\uC120\uCC29\uC7A5\uC758 \uC219\uBD80\uB301 \uD558\uC778 \uB9CC\uB098\uAE30"
    targetId: sukbu_servant
    faction: 3
    count: 1
    radius: 0
    onBegin: []
    onEnd: []
    dialogue:
    - speaker: "\uD558\uC778"
      text: "\uC544\uC528, \uB098\uB9AC\uAED8\uC11C \uBCF4\uB0B4\uC168\uC2B5\uB2C8\uB2E4.
        \uD574\uC6D4\uB3C4\uB85C\uB294 \uB3CC\uC544\uC624\uC9C0 \uB9C8\uC2DC\uB78D\uB2C8\uB2E4."
    - speaker: "\uD558\uC778"
      text: "\uB9DD\uC6B4\uB3C4\uB85C \uAC00\uC2DC\uB78D\uB2C8\uB2E4. \uADF8\uACF3
        \uAD00\uC544\uC5D0 \uB9D0\uC744 \uB123\uC5B4 \uB450\uC168\uB2E4\uACE0\uC694."
    - speaker: "\uD61C"
      text: "\uC219\uBD80\uB2D8\uC774\u2026 \uB0B4\uAC00 \uBA85\uC744 \uAC70\uC2A4\uB978
        \uAC78 \uC5B4\uB5BB\uAC8C \uBC8C\uC368 \uC544\uC2DC\uACE0?"
    - speaker: "\uD558\uC778"
      text: "\uB098\uB9AC\uB294 \uB298 \uC544\uC528\uB97C \uC9C0\uCF1C\uBCF4\uACE0
        \uACC4\uC2ED\uB2C8\uB2E4."
