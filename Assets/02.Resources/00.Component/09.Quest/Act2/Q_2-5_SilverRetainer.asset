  - type: 0
    description: "\uC131\uC758 \uC601\uC8FC\uC5D0\uAC8C \uAC00\uAE30"
    targetId: kurose
    faction: 3
    count: 1
    radius: 0
    onBegin: []
    onEnd: []
    dialogue:
    - speaker: "\uAD6C\uB85C\uC138"
      text: "\uC65C\uAD6C\uAC00 \uB0B4 \uC218\uC1A1\uC120 \uAE38\uC744 \uB108\uBB34
        \uC798 \uC548\uB2E4. \uB0B4 \uAC00\uC2E0 \uAC00\uC6B4\uB370 \uB204\uAD70\uAC00
        \uC815\uBCF4\uB97C \uD758\uB9AC\uACE0 \uC788\uC18C."
    - speaker: "\uAD6C\uB85C\uC138"
      text: "\uC758\uC2EC \uAC00\uB294 \uC790\uAC00 \uC788\uC18C. \uC131 \uC544\uB798\uB85C
        \uB0B4\uB824\uAC00\uB294 \uADF8\uC790\uB97C \uB530\uB77C\uAC00 \uBCF4\uC2DC\uC624.
        \uB4E4\uD0A4\uBA74 \uB05D\uC774\uC624."
    choices: []
    choiceFlags: []
    spawnTemplates: []
    keepAlive: 2
    spawnDistance: 380
    marker: 
    ignoreTerritory: 1
    escortTemplate: merchant
    escortFaction: 2
    escortSpeed: 4.5
    followStartRange: 30
    minDistance: 5
  - type: 6
    description: "\uC131 \uC544\uB798 \uAE38\uC5D0\uC11C \uAC00\uC2E0\uC744 \uB4E4\uD0A4\uC9C0
      \uC54A\uAC8C \uBBF8\uD589"
    targetId: retainer
    faction: 3
    count: 1
    radius: 45
    onBegin:
    - type: 5
      text: masked_man
      faction: 1
      value: 1
      template: 
      distance: 400
      marker: 
      ignoreTerritory: 0
      factionOverride: -1
      lines: []
    onEnd: []
    dialogue:
    - speaker: "\uAC00\uC2E0"
      text: "\uC57D\uC18D\uD55C \uBB3C\uAC74\uC774\uC624. \uB2E4\uC74C \uC218\uC1A1\uC120\uC740
        \uC0AC\uD758 \uB4A4 \uBD81\uC11C \uD3EC\uAD6C\uB85C \uB098\uAC00\uC624."
    - speaker: "\uC815\uCCB4 \uBAA8\uB97C \uC870\uC120\uC778"
      text: "\uC218\uACE0\uD588\uC18C. \uC740\uC740 \uB298 \uADF8\uB807\uB4EF \uB109\uB109\uD788
        \uB123\uC5C8\uC18C."
    - speaker: "\uAC00\uC2E0"
      text: "\uC870\uC120 \uB098\uB9AC\uB4E4\uC740 \uC190\uC774 \uD06C\uAD6C\uB824."
    - speaker: "\uD61C"
      text: "(\uC870\uC120 \uC0AC\uB78C\uC774\u2026 \uC65C\uAD6C\uC5D0\uAC8C \uAE38\uC744
        \uB300 \uC8FC\uACE0 \uC788\uB2E4\uACE0?)"
