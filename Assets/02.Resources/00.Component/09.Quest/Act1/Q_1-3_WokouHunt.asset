  - type: 0
    description: "\uD574\uC6D4\uB3C4 \uD604\uAC10\uC5D0\uAC8C \uBCF4\uACE0\uD558\uAE30"
    targetId: hyeongam
    faction: 3
    count: 1
    radius: 0
    onBegin: []
    onEnd: []
    dialogue:
    - speaker: "\uD604\uAC10 \uC870\uBA85\uAD6C"
      text: "\uC5F4 \uCC99\uC774\uB77C\u2026 \uB4E3\uB358 \uAC83\uBCF4\uB2E4 \uC19C\uC528\uAC00
        \uC88B\uAD6C\uB824."
    - speaker: "\uD604\uAC10 \uC870\uBA85\uAD6C"
      text: "\uD5CC\uB370 \uB188\uB4E4 \uADFC\uAC70\uC9C0\uAC00 \uB530\uB85C \uC788\uC18C.
        \uC77C\uBCF8\uC12C \uAD6C\uB85C\uC138\uC9C0\uB9C8. \uC65C\uAD6C\uAC00 \uADF8
        \uC12C \uC601\uC8FC\uC758 \uBE44\uD638\uB97C \uBC1B\uB294\uB2E4\uB294 \uB9D0\uC774
        \uB3CC\uACE0 \uC788\uC18C."
    - speaker: "\uD61C"
      text: "\uADF8 \uC12C\uC73C\uB85C \uAC00\uB77C\uB294 \uB9D0\uC500\uC785\uB2C8\uAE4C?"
    - speaker: "\uD604\uAC10 \uC870\uBA85\uAD6C"
      text: "\uC7A0\uC785\uD558\uC2DC\uC624. \uB2E4\uB9CC \uC870\uC120 \uBC30\uB97C
        \uC77C\uBCF8\uAD70\uC774 \uACF1\uAC8C \uB4E4\uC5EC\uBCF4\uB0B4 \uC904 \uB9AC
        \uC5C6\uC9C0. \uAD00\uAD70\uACFC \uD55C\uBC14\uD0D5 \uC2F8\uC6CC \uCAD3\uAE30\uB294
        \uBC00\uBB34\uC5ED\uC120\uCC98\uB7FC \uBCF4\uC774\uBA74 \uC800\uB4E4\uB3C4
        \uC758\uC2EC\uC744 \uB35C \uD560 \uAC8C\uC694."
    - speaker: "\uD61C"
      text: "\u2026\uAD00\uAD70\uACFC \uC2F8\uC6B0\uB780 \uB9D0\uC500\uC774\uAD70\uC694."
    - speaker: "\uD604\uAC10 \uC870\uBA85\uAD6C"
      text: "\uAD00\uAD70 \uCABD \uB4B7\uC77C\uC740 \uB0B4\uAC00 \uC218\uC2B5\uD558\uACA0\uC18C.
        \uC774\uAC74 \uC57D\uC18D\uD55C \uAC12\uC774\uC624."
