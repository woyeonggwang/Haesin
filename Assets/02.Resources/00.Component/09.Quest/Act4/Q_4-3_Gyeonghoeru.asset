  introDialogue: []
  objectives:
  - type: 0
    description: "\uACBD\uD68C\uB8E8\uC5D0 \uBAA8\uC778 \uBC18\uB780\uD30C\uC640
      \uAD8C\uC2DC\uD5CC \uB9CC\uB098\uAE30"
    targetId: gwon_palace
    faction: 3
    count: 1
    radius: 0
    onBegin: []
    onEnd: []
    dialogue:
    - speaker: "\uAD8C\uC2DC\uD5CC"
      text: "\uBAA8\uB450 \uBAA8\uC600\uAD70. \uACC4\uD68D\uC744 \uB2E4\uC2DC \uB9D0\uD558\uACA0\uC18C."
    - speaker: "\uAD8C\uC2DC\uD5CC"
      text: "\uC790\uC815\uC5D0 \uB300\uBE44\uC804\uC5D0 \uBD88\uC744 \uC9C0\uB978\uB2E4.
        \uAD81\uC758 \uB208\uC774 \uBAA8\uB450 \uADF8\uB9AC\uB85C \uC3E0\uB9B4 \uAC83\uC774\uC624."
    - speaker: "\uBC18\uB780\uD30C \uBB34\uC0AC"
      text: "\uB300\uBE44\uB294 \uC6B0\uB9AC\uAC00 \uB9E1\uACA0\uC18C. \uADF8 \uC5EC\uC790\uAC00
        \uC0B4\uC544 \uC788\uB294 \uD55C \uC870\uC815\uC740 \uBC14\uB85C \uC11C\uC9C0
        \uBABB\uD558\uC624."
    - speaker: "\uAD8C\uC2DC\uD5CC"
      text: "\uADF8\uB300\uB294 \uAC15\uB155\uC804\uC73C\uB85C \uAC00 \uC655\uC744
        \uBD99\uC7A1\uC544 \uB450\uC2DC\uC624. \uC0C8 \uC655\uC744 \uBAA8\uC2E4 \uB54C\uAE4C\uC9C0
        \uADF8\uC790\uAC00 \uC6C0\uC9C1\uC774\uC9C0 \uBABB\uD558\uAC8C."
    - speaker: "\uD61C"
      text: "\uBD99\uC7A1\uC544 \uB450\uAE30\uB9CC \uD558\uB77C\uB294 \uAC81\uB2C8\uAE4C?
        \uC544\uBC84\uC9C0\uB97C \uC8FD\uC778 \uC790\uB97C?"
    - speaker: "\uAD8C\uC2DC\uD5CC"
      text: "\u2026\uADF8\uB300\uC758 \uCE7C\uC774\uB2C8, \uADF8\uB300\uAC00 \uC815\uD558\uC2DC\uC624."
    choices: []
    choiceFlags: []
    spawnTemplates: []
