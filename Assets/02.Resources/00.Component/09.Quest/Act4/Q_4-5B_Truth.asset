  questId: 4-5B
  act: "4\uB9C9"
  title: "\uC655\uC758 \uACE0\uBC31"
  giver: "\uD604\uC655 \uC774\uB2F4"
  summary: "\uBD84\uAE30 \u2461 \uC655\uC744 \uC8FD\uC774\uC9C0 \uC54A\uB294\uB2E4
    \u2014 \uC655\uC774 \uB300\uBE44\uC758 \uB3C5\uC0B4 \uC0AC\uC2E4\uC744 \uD138\uC5B4\uB193\uC740
    \uB4A4 \uC2A4\uC2A4\uB85C \uBAA9\uC228\uC744 \uB04A\uB294\uB2E4."
  onStart: []
  introDialogue: []
  objectives:
  - type: 0
    description: "\uCE7C\uC744 \uAC70\uB450\uACE0 \uC655\uC758 \uC774\uC57C\uAE30
      \uB4E3\uAE30"
    targetId: king
    faction: 3
    count: 1
    radius: 0
    onBegin: []
    onEnd: []
    dialogue:
    - speaker: "\uC655"
      text: "\uD615\uB2D8\uC744\u2026 \uB124 \uC544\uBC84\uC9C0\uB97C \uB3C5\uC0B4\uD55C
        \uAC83\uC740 \uB0B4 \uC5B4\uBA38\uB2C8, \uB300\uBE44\uC600\uB2E4."
    - speaker: "\uC655"
      text: "\uB124 \uC5B4\uBA38\uB2C8 \uC219\uC758 \uC815\uC528\uB3C4 \uADF8 \uC77C\uC744
        \uB208\uCE58\uCC44\uACE0 \uBAA9\uC228\uC744 \uC783\uC5C8\uB2E4."
    - speaker: "\uC655"
      text: "\uB098\uB294 \uC54C\uBA74\uC11C\uB3C4 \uC5B4\uBA38\uB2C8\uB97C \uBC8C\uD558\uC9C0
        \uBABB\uD588\uB2E4. \uACE0\uBC1C\uD558\uC9C0\uB3C4 \uBABB\uD588\uB2E4. \uADF8\uC800
        \uB108\uB97C \uC5B4\uBA38\uB2C8 \uB208\uC5D0\uC11C \uC228\uAE30\uB294 \uAC83\uBC16\uC5D0."
    - speaker: "\uD61C"
      text: "\uAD8C\uC2DC\uD5CC\uC740\u2026 \uC219\uBD80\uB2D8\uC774 \uC544\uBC84\uC9C0\uB97C
        \uC8FD\uC600\uB2E4\uACE0 \uD588\uC2B5\uB2C8\uB2E4."
    - speaker: "\uC655"
      text: "\uADF8\uC790\uB294 \uB124\uAC00 \uB9DD\uC124\uC774\uC9C0 \uC54A\uAE30\uB97C
        \uBC14\uB790\uACA0\uC9C0. \u2026\uC5B4\uBA38\uB2C8\uB3C4 \uC624\uB298 \uBC24
        \uAC00\uC168\uAD6C\uB098."
    - speaker: "\uC655"
      text: "\uD61C\uC57C. \uC774\uC81C \uAC00\uAC70\uB77C. \uB4A4\uB3CC\uC544\uBCF4\uC9C0
        \uB9D0\uACE0."
