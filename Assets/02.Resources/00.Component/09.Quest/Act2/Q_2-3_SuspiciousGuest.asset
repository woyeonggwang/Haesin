  act: "2\uB9C9"
  title: "\uC758\uC2EC\uBC1B\uB294 \uC190\uB2D8"
  giver: "\uC601\uC8FC \uAD6C\uB85C\uC138 \uB9C8\uC0AC\uD1A0\uD0A4"
  summary: "[\uD638\uC704] \uC870\uC120\uC5D0\uC11C \uC628 \uD61C\uB97C \uBBFF\uC9C0
    \uBABB\uD558\uB294 \uC601\uC8FC\uAC00 \uC2DC\uD5D8 \uC0BC\uC544 \uC300 \uC218\uC1A1\uC120
    \uD638\uC704\uB97C \uB9E1\uAE34\uB2E4. \uB3C4\uC911\uC5D0 \uC65C\uAD6C\uAC00
    \uC2B5\uACA9\uD55C\uB2E4."
  onStart: []
  introDialogue: []
  objectives:
  - type: 0
    description: "\uC131\uC73C\uB85C \uC62C\uB77C\uAC00 \uC601\uC8FC \uAD6C\uB85C\uC138
      \uB9CC\uB098\uAE30"
    targetId: kurose
    faction: 3
    count: 1
    radius: 0
    onBegin: []
    onEnd: []
    dialogue:
    - speaker: "\uAD6C\uB85C\uC138"
      text: "\uD558\uC57C\uC2DC\uAC00 \uBCF4\uB0B8 \uC870\uC120 \uC0AC\uB78C\uC774
        \uADF8\uB300\uC778\uAC00."
    - speaker: "\uAD6C\uB85C\uC138"
      text: "\uC870\uC120 \uBC30\uAC00 \uC65C\uAD6C\uB97C \uCE5C\uB2E4? \uC27D\uAC8C
        \uBBFF\uAE30\uC9C0 \uC54A\uB294\uAD70. \uC870\uC120\uACFC \uC65C\uAD6C\uAC00
        \uD55C\uD1B5\uC18D\uC774\uB77C\uB294 \uB9D0\uB3C4 \uB3C8\uB2E4."
    - speaker: "\uD61C"
      text: "\uBBFF\uC9C0 \uBABB\uD558\uC2DC\uACA0\uB2E4\uBA74 \uC2DC\uD5D8\uD574
        \uBCF4\uC2ED\uC2DC\uC624."
    - speaker: "\uAD6C\uB85C\uC138"
      text: "\uC88B\uB2E4. \uB0B4 \uC300 \uC218\uC1A1\uC120\uC774 \uBD81\uC11C \uD3EC\uAD6C\uB85C
        \uB098\uAC04\uB2E4. \uBB34\uC0AC\uD788 \uB2FF\uAC8C \uC9C0\uCF1C\uB77C. \uADF8\uB7EC\uBA74
        \uADF8\uB300 \uB9D0\uC744 \uBBFF\uC5B4 \uC8FC\uC9C0."
