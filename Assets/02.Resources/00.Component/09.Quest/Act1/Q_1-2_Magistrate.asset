    count: 1
    radius: 0
    onBegin: []
    onEnd: []
    dialogue:
    - speaker: "\uD604\uAC10 \uC870\uBA85\uAD6C"
      text: "\uC219\uBD80 \uB418\uC2DC\uB294 \uBD84\uAED8 \uC774\uC57C\uAE30\uB294
        \uB4E4\uC5C8\uC18C. \uBC30\uB97C \uBAB0\uACE0 \uC65C\uAD6C\uC640 \uC2F8\uC6E0\uB2E4\uC9C0?"
    - speaker: "\uD61C"
      text: "\uC608. \uBB34\uC5C7\uC744 \uB3C4\uC640\uB4DC\uB9AC\uBA74 \uB418\uACA0\uC2B5\uB2C8\uAE4C."
    - speaker: "\uD604\uAC10 \uC870\uBA85\uAD6C"
      text: "\uC694\uC998 \uC65C\uAD6C\uAC00 \uD574\uC6D4\uB3C4 \uC55E\uBC14\uB2E4\uB97C
        \uC81C\uC9D1\uCC98\uB7FC \uB4DC\uB098\uB4DC\uC624. \uAD00\uAD70 \uBC30\uB85C\uB294
        \uAC10\uB2F9\uC774 \uC548 \uB418\uB2C8, \uADF8\uB300\uAC00 \uC65C\uAD6C \uBC30
        \uC5F4 \uCC99\uB9CC \uBC14\uB2E4\uC5D0 \uAC00\uB77C\uC549\uD600 \uC8FC\uC2DC\uC624."
    - speaker: "\uD604\uAC10 \uC870\uBA85\uAD6C"
      text: "\uAC12\uC740 \uD6C4\uD788 \uCE58\uB974\uB9AC\uB2E4."
