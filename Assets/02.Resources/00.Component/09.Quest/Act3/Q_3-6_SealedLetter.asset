    - speaker: "\uD61C"
      text: "\uAC10\uC2DC\uC778\uB354\uB7EC \uC8C4\uC778\uC758 \uC11C\uC2E0\uC744
        \uB098\uB974\uB77C\uB294 \uAC81\uB2C8\uAE4C?"
    - speaker: "\uD55C\uC724\uACB8"
      text: "\uADF8\uB300\uB294 \uAC10\uC2DC\uC778\uC774 \uC544\uB2C8\uC624. \u2026\uB54C\uAC00
        \uB418\uBA74 \uC54C\uAC8C \uB420 \uAC83\uC774\uC624."
    - speaker: "\uD55C\uC724\uACB8"
      text: "\uAD00\uC544\uC5D0\uB294 \uB0B4\uAC00 \uC190\uC744 \uC368 \uB450\uC5C8\uC18C.
        \uAC00\uC2DC\uC624."
