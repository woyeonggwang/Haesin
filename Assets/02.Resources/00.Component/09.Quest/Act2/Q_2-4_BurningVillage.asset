    dialogue:
    - speaker: "\uAD6C\uB85C\uC138"
      text: "\uC870\uC120\uC2DD \uD654\uD3EC\uB77C\u2026 \uC124\uBA85\uD574 \uBCF4\uC2DC\uC624.
        \uC870\uC120\uC774 \uC65C\uAD6C\uB97C \uB3D5\uACE0 \uC788\uB294 \uAC83\uC774\uC624?"
    - speaker: "\uD61C"
      text: "\uC800\uB3C4 \uBAA8\uB985\uB2C8\uB2E4. \uD558\uC9C0\uB9CC \uC774\uAC8C
        \uC870\uC120 \uC870\uC815\uC758 \uB73B\uC774\uB77C\uACE0\uB294 \uBBFF\uC9C0
        \uC54A\uC2B5\uB2C8\uB2E4."
    - speaker: "\uAD6C\uB85C\uC138"
      text: "\u2026\uADF8 \uB208\uBE5B\uC740 \uAC70\uC9D3\uB9D0\uD558\uB294 \uC0AC\uB78C\uC758
        \uAC83\uC774 \uC544\uB2C8\uAD70. \uC88B\uC18C. \uB2E4\uB9CC \uC9C0\uCF1C\uBCF4\uACA0\uC18C."
