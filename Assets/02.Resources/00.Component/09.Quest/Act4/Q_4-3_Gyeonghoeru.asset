  giver: "\uAD8C\uC2DC\uD5CC\xB7\uBC18\uB780\uD30C"
  summary: "\uAC70\uC0AC \uACC4\uD68D\uC744 \uB4E3\uB294\uB2E4: \uB300\uBE44\uC804\uC5D0
    \uBD88\uC744 \uC9C8\uB7EC \uC774\uBAA9\uC744 \uB04C\uACE0 \uB300\uBE44\uB97C
    \uC81C\uAC70, \uD61C\uB294 \uAC15\uB155\uC804\uC5D0\uC11C \uC655\uC744 \uBD99\uC7A1\uC544
    \uB454\uB2E4."
