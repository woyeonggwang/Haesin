  - type: 0
    description: "\uB098\uB8FB\uBC30(E 3\uCD08)\uB85C \uD638\uC218\uB97C \uAC74\uB108
      \uC721\uC870\uAC70\uB9AC\uC758 \uAD8C\uC2DC\uD5CC \uB9CC\uB098\uAE30"
    targetId: gwon_hanyang
    faction: 3
    count: 1
    radius: 0
    onBegin: []
    onEnd: []
    dialogue:
    - speaker: "\uAD8C\uC2DC\uD5CC"
      text: "\uD55C \uB300\uAC10\uC758 \uC11C\uC2E0\uC774\uB77C\u2026 (\uC11C\uC2E0\uC744
        \uC77D\uB294\uB2E4) \u2026\uADF8\uB807\uAD70. \uC5ED\uC2DC \uADF8\uB7AC\uC5B4."
    - speaker: "\uAD8C\uC2DC\uD5CC"
      text: "\uADF8\uB300\uC758 \uC774\uB984\uC774 \uD61C\uB77C\uACE0? \uADF8\uB300\uB294
        \uC120\uC655 \uC560\uC885 \uC804\uD558\uC758 \uD54F\uC904\uC774\uC624. \uC219\uC758
        \uC815\uC528 \uB9C8\uB9C8\uC758 \uB530\uB2D8\uC774\uC2DC\uC9C0."
    - speaker: "\uD61C"
      text: "\uBB34\uC2A8\u2026 \uB9D0\uC500\uC774\uC2ED\uB2C8\uAE4C?"
    - speaker: "\uAD8C\uC2DC\uD5CC"
      text: "\uC120\uC655\uAED8\uC11C\uB294 \uBCD1\uC73C\uB85C \uC2B9\uD558\uD558\uC2E0
        \uAC8C \uC544\uB2C8\uC624. \uB3C5\uC0B4\uB2F9\uD558\uC168\uC18C."
    - speaker: "\uAD8C\uC2DC\uD5CC"
      text: "\uADF8\uB9AC\uACE0 \uADF8 \uC790\uB9AC\uC5D0 \uC624\uB978 \uC790\uAC00
        \uC9C0\uAE08\uC758 \uC655\uC774\uC624. \uADF8\uB300\uC758 \uC544\uBC84\uC9C0\uB97C
        \uC8FD\uC774\uACE0 \uC655\uC704\uB97C \uCC28\uC9C0\uD55C \uC790."
    - speaker: "\uD61C"
      text: "\u2026\u2026"
