  - type: 0
    description: "\uC0C1\uC778 \uAC70\uB9AC\uC758 \uC9C0\uC8FC \uD558\uC57C\uC2DC\uC640
      \uC774\uC57C\uAE30\uD558\uAE30"
    targetId: hayashi
    faction: 3
    count: 1
    radius: 0
    onBegin: []
    onEnd: []
    dialogue:
    - speaker: "\uD558\uC57C\uC2DC"
      text: "\uC870\uC120 \uBC30\uB77C\u2026 \uAD00\uAD70\uC5D0 \uCAD3\uAE30\uB2E4
        \uC5EC\uAE30\uAE4C\uC9C0 \uC654\uB2E4\uB294 \uC18C\uBB38\uC740 \uB4E4\uC5C8\uC18C."
    - speaker: "\uD61C"
      text: "\uC7A5\uC0AC\uB97C \uD558\uB7EC \uC654\uC2B5\uB2C8\uB2E4. \uC77C\uBCF8
        \uCABD \uBC14\uB2E4\uB294 \uC5B4\uB5BB\uC2B5\uB2C8\uAE4C?"
    - speaker: "\uD558\uC57C\uC2DC"
      text: "\uC5B4\uB5BB\uAE34. \uC65C\uAD6C \uB188\uB4E4 \uB54C\uBB38\uC5D0 \uC300
        \uD55C \uC12C \uC2E4\uC5B4 \uB098\uB974\uAE30\uAC00 \uBAA9\uC228 \uAC78\uACE0
        \uD558\uB294 \uC77C\uC774 \uB410\uC18C."
    - speaker: "\uD558\uC57C\uC2DC"
      text: "\uBC30\uAC00 \uC788\uACE0 \uD3EC\uAC00 \uC788\uB2E4\uB2C8\u2026 \uADF8\uB300\uC5D0\uAC8C
        \uBD80\uD0C1\uD560 \uC77C\uC774 \uC0DD\uAE38\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uAD6C\uB824."
